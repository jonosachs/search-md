{
    "compilerOptions": {
      "target": "ES2021",
      "module": "esnext",
      "moduleResolution": "bundler",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "sourceMap": true,
      "outDir": "dist",
      "rootDir": "./src"
    },
    "include": ["src/**/*"]
}
